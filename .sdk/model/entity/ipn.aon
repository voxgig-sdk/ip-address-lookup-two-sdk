# Entity: ipn

main: kit: entity: ipn: {

  alias: field: {}

  fields: [
    {
      name: "asn"
      req: false
      short: "Autonomous System Number"
      type: "`$STRING`"
    }
    {
      name: "city"
      req: false
      short: "City name"
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country name"
      type: "`$STRING`"
    }
    {
      name: "country_code"
      req: false
      short: "ISO country code"
      type: "`$STRING`"
    }
    {
      name: "ip"
      req: false
      short: "The IP address"
      type: "`$STRING`"
    }
    {
      name: "isp"
      req: false
      short: "Internet Service Provider"
      type: "`$STRING`"
    }
    {
      name: "latitude"
      req: false
      short: "Latitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      short: "Longitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "organization"
      req: false
      short: "Organization name"
      type: "`$STRING`"
    }
    {
      name: "region"
      req: false
      short: "Region or state"
      type: "`$STRING`"
    }
    {
      name: "timezone"
      req: false
      short: "Timezone identifier"
      type: "`$STRING`"
    }
  ]

  name: "ipn"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "8.8.8.8"
                kind: "query"
                name: "ip"
                orig: "ip"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/ip"
          parts: [
            "ip"
          ]
          select: {
            exist: [
              "ip"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
